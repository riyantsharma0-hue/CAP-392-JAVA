class Solution {
    public int romanToInt(String s) {

        int total = 0;

        for (int i = 0; i < s.length(); i++) {

            int value = 0;

            char ch = s.charAt(i);

            if (ch == 'I')
                value = 1;
            else if (ch == 'V')
                value = 5;
            else if (ch == 'X')
                value = 10;
            else if (ch == 'L')
                value = 50;
            else if (ch == 'C')
                value = 100;
            else if (ch == 'D')
                value = 500;
            else if (ch == 'M')
                value = 1000;

            if (i + 1 < s.length() && value < getNextValue(s, i)) {
                total = total - value;
            }
            else {
                total = total + value;
            }
        }

        return total;
    }

    public int getNextValue(String s, int i) {

        char ch = s.charAt(i + 1);

        if (ch == 'I') return 1;
        else if (ch == 'V') return 5;
        else if (ch == 'X') return 10;
        else if (ch == 'L') return 50;
        else if (ch == 'C') return 100;
        else if (ch == 'D') return 500;
        else return 1000;
    }
}
